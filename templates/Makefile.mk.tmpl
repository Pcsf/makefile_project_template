# ==============================================================================
# Makefile.mk — Reference template
#
# This is the canonical template used by scan_project.sh/.bat.
# DO NOT copy this into source directories — run 'make scan' instead.
#
# ── How VHDL ordering works ───────────────────────────────────────────────────
# VHDL compilation order is significant: a package or entity must be compiled
# before any design unit that references it (via 'use', component instantiation,
# or direct entity instantiation).  The auto-discovered wildcard order is
# alphabetical and will often be wrong.  Three layers fix this:
#
# Layer 3 — silent pre-pass (automatic, no user action)
#   ghdl.mk and modelsim.mk compile all files once silently before the real
#   pass.  This pre-populates the work library so the real pass finds all
#   dependencies already compiled, regardless of order in VHDL_SRCS.
#   Handles most real-world designs with zero effort.
#
# Layer 2 — .compile_order file (per directory, survives rescans)
#   'make scan' creates a .compile_order file in each VHDL directory, listing
#   files alphabetically as a starting point.  Edit it to set the correct
#   within-directory order.  NEVER overwritten by subsequent 'make scan' runs.
#   This block reads it when present; falls back to $(wildcard) otherwise.
#
# Layer 1 — VHDL_SRCS_DIR in project.mk (cross-directory ordering)
#   Set VHDL_SRCS_DIR to a list of directories in compilation order.
#   The root Makefile assembles VHDL_SRCS by expanding each directory through
#   its .compile_order (or wildcard) — you declare directory order, file
#   discovery within each directory stays fully automatic.
#
# ── How $(wildcard) auto-update works ────────────────────────────────────────
# C_SRCS/CXX_SRCS/V_SRCS/ASM_SRCS are initialised with ':=' in the root
# Makefile before sub-makefiles are included.  This makes every '+=' here
# expand $(wildcard …) immediately at parse time — giving an always-current
# file list on every 'make' invocation without rescanning.
# ==============================================================================

# Capture this file's directory at include time (standard GNU make idiom)
_THIS_DIR := $(dir $(lastword $(MAKEFILE_LIST)))

# ── C sources ─────────────────────────────────────────────────────────────────
C_SRCS    += $(wildcard $(_THIS_DIR)*.c)

# ── C++ sources ───────────────────────────────────────────────────────────────
CXX_SRCS  += $(wildcard $(_THIS_DIR)*.cpp $(_THIS_DIR)*.cxx $(_THIS_DIR)*.cc)

# ── VHDL sources ──────────────────────────────────────────────────────────────
# VHDL compilation order matters: packages must precede their users, entities
# must precede their instantiators.  Create/edit .compile_order (one filename
# per line, no paths) to control order.  The toolchain makefiles also run a
# silent pre-pass to auto-resolve simple out-of-order cases.
ifneq ($(wildcard $(_THIS_DIR).compile_order),)
# .compile_order found — use explicit order (strips # comments and blank lines)
# Literal '#' routed through _HASH: a bare '#' inside a function call is a
# comment start on make < 4.3 ("unterminated call to function"), while '\#'
# leaks the backslash into the shell on make >= 4.3.  Escaping in a plain
# variable assignment works on every version (same idiom as the root Makefile).
_HASH := \#
VHDL_SRCS += $(addprefix $(_THIS_DIR),\
    $(shell grep -v '^[[:space:]]*$(_HASH)' '$(_THIS_DIR).compile_order' \
            | grep -v '^[[:space:]]*$$'))
else
# No .compile_order — alphabetical fallback (run 'make scan' to create one)
VHDL_SRCS += $(wildcard $(_THIS_DIR)*.vhd $(_THIS_DIR)*.vhdl)
endif

# ── Verilog / SystemVerilog sources ───────────────────────────────────────────
V_SRCS    += $(wildcard $(_THIS_DIR)*.v $(_THIS_DIR)*.sv)

# ── Assembly sources ──────────────────────────────────────────────────────────
ASM_SRCS  += $(wildcard $(_THIS_DIR)*.s $(_THIS_DIR)*.S $(_THIS_DIR)*.asm)
